:root {
  --fondo: #f6f4ef;
  --texto: #1d2b2a;
  --principal: #2f6f6a;
  --acento: #e0a526;
  --borde: #cfd8d5;
  --blanco: #ffffff;
}
* { box-sizing: border-box; }
body {
  margin: 0;
  font-family: "Segoe UI", system-ui, sans-serif;
  line-height: 1.6;
  color: var(--texto);
  background: var(--fondo);
}
.contenedor { max-width: 820px; margin: 0 auto; padding: 1.5rem; }

/* Encabezado: foto + título */
header { display: flex; align-items: center; gap: 1.25rem; padding-bottom: 1rem; }
header img, header .avatar { width: 110px; height: 110px; object-fit: cover; border: 3px solid var(--principal); border-radius: 50%; flex-shrink: 0; }
header h1 { margin: 0; font-family: Georgia, serif; font-size: clamp(1.6rem, 4vw, 2.4rem); }
header p { margin: 0; color: var(--principal); }

/* Menú */
nav { background: var(--principal); border-radius: 6px; }
nav ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; }
nav a { display: block; padding: .8rem 1.2rem; color: var(--blanco); text-decoration: none; font-weight: 600; }
nav a:hover, nav a:focus-visible { background: rgba(255,255,255,.18); outline: none; }
nav a[aria-current="page"] { box-shadow: inset 0 -4px 0 var(--acento); }

/* Secciones */
main { display: grid; gap: 1.25rem; margin: 1.5rem 0; }
section, article { background: var(--blanco); border: 1px solid var(--borde); border-radius: 8px; padding: 1.25rem 1.5rem; }
h2 { margin-top: 0; font-family: Georgia, serif; color: var(--principal); }
h3 { margin-bottom: .25rem; }
dl { display: grid; grid-template-columns: max-content 1fr; gap: .4rem 1.25rem; margin: 0; }
dt { font-weight: 700; }
dd { margin: 0; }
a { color: var(--principal); }

/* Estudios: cuadrícula de valores */
.rejilla { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem; }
.rejilla article { background: var(--fondo); }
.rejilla h3 { margin-top: 0; }
.rejilla time { font-size: .9rem; color: #52625f; }

/* Multimedia */
.video { position: relative; aspect-ratio: 16 / 9; }
.video iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; border-radius: 6px; }
figure { margin: 0; }
figcaption { font-size: .9rem; color: #52625f; margin-top: .4rem; }
figure img { max-width: 100%; border-radius: 6px; }

/* Pie de página */
footer { text-align: center; padding: 1rem 0 2rem; font-size: .9rem; color: #52625f; }

:focus-visible { outline: 3px solid var(--acento); outline-offset: 2px; }
@media (max-width: 520px) {
  header { flex-direction: column; text-align: center; }
  dl { grid-template-columns: 1fr; }
}
